# Release signing configuration for DoomBrake.
#
# PENTING: File ini TIDAK BOLEH dicommit ke Git!
# Tambahkan ke .gitignore: android/keystore.properties
#
# Langkah membuat keystore release:
#   keytool -genkeypair -v \
#     -keystore app/doombrake-release.keystore \
#     -alias doombrake \
#     -keyalg RSA -keysize 2048 \
#     -validity 10000 \
#     -storepass YOUR_STORE_PASSWORD \
#     -keypass YOUR_KEY_PASSWORD
#
# Isi file ini sesuai nilai yang kamu gunakan di atas:

storeFile=doombrake-release.keystore
storePassword=GANTI_DENGAN_PASSWORD_KEYSTORE
keyAlias=doombrake
keyPassword=GANTI_DENGAN_PASSWORD_KEY
